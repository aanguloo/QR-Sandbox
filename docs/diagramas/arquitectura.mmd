flowchart TB
  subgraph U["Teléfono del usuario"]
    NAV["Navegador / PWA<br/>decodifica el QR, verifica firmas<br/>y pruebas de Merkle"]
  end
  subgraph P["Red pública"]
    API["API FastAPI<br/>CSP, anti-CSRF, código de acceso,<br/>límites · SIN socket de Docker"]
    LOG[("QR Transparency Log<br/>SQLite append-only + Merkle<br/>STH firmados Ed25519")]
    TUN["Túnel cloudflared<br/>(solo en la demo)"]
  end
  subgraph I["Red interna: sin internet"]
    ORQ["Orquestador<br/>único con el socket de Docker<br/>valida todo lo que llega del worker"]
    REC["Re-codificador Pillow<br/>proceso hijo: nobody, sin grupos,<br/>rlimit 256 MB"]
  end
  subgraph S["Red sandbox (aislada)"]
    W["Worker efímero<br/>Chromium + Playwright · gVisor<br/>UID 10001, sin capabilities, seccomp,<br/>solo lectura, 512 MB, 1 CPU, 20 s"]
    PX["Proxy de salida anti-SSRF<br/>valida la IP resuelta en cada conexión"]
  end
  NET(("Internet<br/>sitio del QR"))

  NAV -- "texto del QR + ubicación ~100 m (HTTPS)" --> TUN --> API
  NAV -. "en local / red local" .-> API
  API -- "SSE / sondeo: eventos, imágenes JPEG, veredicto" --> NAV
  API <--> LOG
  API -- "POST /analizar {url} (interfaz estrecha)" --> ORQ
  ORQ -- "NDJSON validado" --> API
  ORQ -- "crea y destruye (--rm)" --> W
  W -- "stdout: 1 evento JSON por línea (tainted)" --> ORQ
  ORQ <--> REC
  W -- "único egreso" --> PX
  PX -- "solo IPs públicas, puertos 80/443" --> NET
