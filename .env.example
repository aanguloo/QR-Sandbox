# Copiar a .env y ajustar. .env no se versiona.
API_PORT=8000
# 127.0.0.1 = solo este equipo. 0.0.0.0 = accesible por la red local (Fase 5).
API_BIND=127.0.0.1
# Código de acceso para la demo pública (Fase 8). Vacío = modo desarrollo (sin código).
# `make demo` genera uno aleatorio si está vacío. Con valor, la API exige el código para
# lanzar análisis y escribir en el log (cookie HttpOnly; Secure; SameSite=Strict).
DEMO_ACCESS_CODE=
# Worker. Perfil de aislamiento: basico | endurecido | gvisor
# (gvisor cae a endurecido si runsc no está disponible, y queda registrado).
WORKER_IMAGEN=qrsandbox-worker:dev
WORKER_PERFIL=gvisor
MAX_WORKERS=3
# Señales con red (RDAP + certificado TLS). 0 = solo señales offline.
SENALES_RED=1
