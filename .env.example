# Copiar a .env y ajustar. .env no se versiona.
API_PORT=8000
# 127.0.0.1 = solo este equipo. 0.0.0.0 = accesible por la red local (Fase 5).
API_BIND=127.0.0.1
# Código de acceso para la demo pública (Fase 8). Vacío = modo desarrollo.
DEMO_ACCESS_CODE=
# Worker (Fase 1+). Runtime: runc | runsc (gVisor, Fase 2).
WORKER_IMAGEN=qrsandbox-worker:dev
WORKER_RUNTIME=runc
WORKER_RED=bridge
MAX_WORKERS=3
